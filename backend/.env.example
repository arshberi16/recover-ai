# RECOVERAI BACKEND ENVIRONMENT CONFIGURATION (EXAMPLE)

# FastAPI Server Port
PORT=8000

# Supabase PostgreSQL Connection String (Pooler or Direct)
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]
DATABASE_URL=postgresql://postgres.example:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Supabase Auth JWT Secret (used for verifying Bearer JWT tokens)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Google Gemini API Key (for AI Insights & Gemini 3.6 Flash Analyst)
GEMINI_API_KEY=your_gemini_api_key_here

# Resend API Credentials (for physical HTML payment recovery email dispatch)
RESEND_API_KEY=re_your_resend_api_key_here
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_your_resend_api_key_here
